from fractions import Fraction

def print_matrix(M):
    """첨가행렬 출력"""
    for row in M:
        coefficients = " ".join(f"{str(v):>6}" for v in row[:-1])
        print(f"[{coefficients} | {str(row[-1]):>6}]")
    print()

# 문제의 첨가행렬
M = [
    [0, -1, -1,  1,  0],
    [1,  1,  1,  1,  6],
    [2,  4,  1, -2, -1],
    [3,  1, -2,  2,  3]
]

M = [[Fraction(v) for v in row] for row in M]
n = len(M)

for col in range(n):
    # 1. 피벗 찾기
    pivot_row = next((r for r in range(col, n) if M[r][col] != 0), None)
    if pivot_row is None:
        raise ValueError("유일해 없음")
    
    # 2. 행 교환
    if pivot_row != col:
        M[col], M[pivot_row] = M[pivot_row], M[col]

    # 3. 피벗 행 정규화 (피벗을 1로 만들기)
    pivot = M[col][col]
    M[col] = [v / pivot for v in M[col]]

    # 4. 소거 진행 (다른 행들을 0으로 만들기)
    for r in range(n):
        if r != col:
            factor = M[r][col]
            M[r] = [M[r][c] - factor * M[col][c] for c in range(n + 1)]

print("최종 해")
for i in range(n):
    print(f"x{i + 1} = {M[i][-1]}")